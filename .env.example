# ---------------------------------------------------------------------------
# APP-JURISPRUDENCIA — configuración
# Ninguna variable es obligatoria: la app arranca con valores por defecto.
# No existe ninguna API key porque CENDOJ no ofrece API pública ni autenticada.
# ---------------------------------------------------------------------------

# --- Fuente oficial (no cambiar salvo que CENDOJ mueva sus rutas) ---
CENDOJ_BASE_URL=https://www.poderjudicial.es/search
CENDOJ_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

# Tiempo máximo (ms) de espera a CENDOJ antes de abortar.
CENDOJ_TIMEOUT_MS=20000
# Reintentos ante página de error transitoria de CENDOJ.
CENDOJ_MAX_REINTENTOS=2
# Vida (ms) de la sesión JSESSIONID reutilizada. CENDOJ invalida sesiones viejas.
CENDOJ_SESION_TTL_MS=480000

# --- Feature flags (ver ARQUITECTURA.md § Feature flags) ---
FLAG_BUSQUEDA_SIMPLE=true
FLAG_BUSQUEDA_AVANZADA=true
FLAG_EXTRACCION_METADATOS=true
FLAG_RESUMEN_CONSERVADOR=true
FLAG_FRAGMENTOS_RELEVANTES=true
FLAG_VERIFICACION_ECLI=true
FLAG_DESCARGA_DOCUMENTO=true

# --- Rate limiting (por IP, ventana deslizante en memoria del proceso) ---
RATE_LIMIT_BUSQUEDAS=20
RATE_LIMIT_VENTANA_MS=60000
RATE_LIMIT_DOCUMENTOS=10

# --- Observabilidad ---
LOG_LEVEL=info
