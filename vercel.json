{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "app/api/texto/route.ts": {
      "maxDuration": 60
    },
    "app/api/documento/route.ts": {
      "maxDuration": 30
    },
    "app/api/buscar/route.ts": {
      "maxDuration": 30
    },
    "app/api/verificar/route.ts": {
      "maxDuration": 30
    },
    "app/api/cita/route.ts": {
      "maxDuration": 60
    },
    "app/api/escrito/route.ts": {
      "maxDuration": 15
    },
    "app/api/boe/route.ts": {
      "maxDuration": 30
    },
    "app/api/traducir/route.ts": {
      "maxDuration": 30
    },
    "app/api/licencia/route.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Fuente-Datos",
          "value": "CENDOJ - Consejo General del Poder Judicial"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:ruta*",
      "has": [
        {
          "type": "host",
          "value": "app-jurisprudencia.vercel.app"
        }
      ],
      "destination": "https://fundalex.vercel.app/:ruta*",
      "permanent": false
    },
    {
      "source": "/:ruta*",
      "has": [
        {
          "type": "host",
          "value": "firme-legal.vercel.app"
        }
      ],
      "destination": "https://fundalex.vercel.app/:ruta*",
      "permanent": false
    }
  ]
}
